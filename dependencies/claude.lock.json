{
  "formatVersion": 1,
  "scope": "Claude Code assets for agentq",
  "installLayout": {
    "bundledSkillSource": "skills/<name>/",
    "bundledSkillTarget": "~/.claude/skills/<name>/",
    "templateSource": "templates/",
    "templateTarget": "~/.local/share/agentq/templates/",
    "supportSource": "support/scripts/",
    "supportTarget": "~/.local/share/agentq/support/scripts/",
    "conflictPolicy": "compare and preserve existing user customizations; never replace unknown content silently",
    "thirdPartyLicenseTarget": "~/.local/share/agentq/licenses/<dependency>-LICENSE"
  },
  "bundledAssets": {
    "skills": [
      {
        "name": "agent-task",
        "sourcePath": "skills/agent-task",
        "target": "~/.claude/skills/agent-task",
        "installPolicy": "required"
      },
      {
        "name": "dispatch",
        "sourcePath": "skills/dispatch",
        "target": "~/.claude/skills/dispatch",
        "installPolicy": "required"
      },
      {
        "name": "nightly-review",
        "sourcePath": "skills/nightly-review",
        "target": "~/.claude/skills/nightly-review",
        "installPolicy": "required"
      },
      {
        "name": "new-project",
        "sourcePath": "skills/new-project",
        "target": "~/.claude/skills/new-project",
        "installPolicy": "required"
      },
      {
        "name": "project-status",
        "sourcePath": "skills/project-status",
        "target": "~/.claude/skills/project-status",
        "installPolicy": "required"
      },
      {
        "name": "no-ai-look",
        "sourcePath": "skills/no-ai-look",
        "target": "~/.claude/skills/no-ai-look",
        "installPolicy": "required"
      },
      {
        "name": "prior-art",
        "sourcePath": "skills/prior-art",
        "target": "~/.claude/skills/prior-art",
        "installPolicy": "required"
      },
      {
        "name": "feedback-triage",
        "sourcePath": "skills/feedback-triage",
        "target": "~/.claude/skills/feedback-triage",
        "installPolicy": "required"
      }
    ],
    "templates": [
      "templates/AGENTS.md",
      "templates/BACKLOG.md",
      "templates/DECISIONS.md",
      "templates/LESSONS.md",
      "templates/PROGRESS.md"
